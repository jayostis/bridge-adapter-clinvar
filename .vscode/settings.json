{
  // Every fixture input validates live against the pinned NCBI schema. The
  // association points at the envelope wrapper, which includes NCBI's XSD and
  // adds the one root element (ClinVarResult-Set) that NCBI's schema does not
  // declare; see schema/ClinVarResult-Set.xsd.
  "xml.fileAssociations": [
    {
      "pattern": "**/fixtures/in/*.xml",
      "systemId": "${workspaceFolder}/schema/ClinVarResult-Set.xsd"
    }
  ],
  "xml.validation.enabled": true,
  // adapter.yaml carries a `# yaml-language-server: $schema=` header too; this
  // association is the belt to that header's braces. fixtures/manifest.ttl is
  // Turtle, validated by SHACL (schema/manifest/bridge-test.shapes.ttl), not
  // by a JSON Schema.
  "yaml.schemas": {
    "./schema/manifest/adapter.schema.json": "adapter.yaml"
  },
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  // Verbatim copies (see .editorconfig): no save-time rewriting. A language
  // override reaches every file in that language, so only languages whose
  // files are verbatim copies (or nearly all are) get one. The .gaps.json
  // sidecars are JSON, and a [json] override would also reach the crate and
  // the JSON Schemas; they rely on the EditorConfig extension recommended in
  // extensions.json, which applies .editorconfig's path-scoped rules.
  "[xml]": {
    "files.insertFinalNewline": false,
    "files.trimTrailingWhitespace": false
  },
  "[turtle]": {
    "files.insertFinalNewline": false,
    "files.trimTrailingWhitespace": false
  }
}
