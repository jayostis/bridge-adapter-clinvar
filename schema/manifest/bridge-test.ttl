# The Bridge-test vocabulary, bt:. A small set of terms on top of W3C's mf:
# test-manifest vocabulary (the one every W3C RDF-family test suite is written
# in), the way the SHACL test suite adds sht:. An adapter's fixtures/manifest.ttl
# is an mf:Manifest whose entries are typed with the three test classes below;
# the type carries the comparison rule. The shape that constrains such a
# manifest is bridge-test.shapes.ttl beside this file.
#
# This file is the seed of the Bridge specification's test vocabulary and
# moves to a bridge-spec repository unchanged when one exists, the role the
# cases JSON Schema played before it. It is a Bridge-spec namespace, not a
# Cascade vocabulary: no cascade: or genomics: term is minted here.

@prefix bt:   <https://ns.cascadeprotocol.org/bridge-test/v1-draft#> .
@prefix mf:   <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .

<https://ns.cascadeprotocol.org/bridge-test/v1-draft#> a owl:Ontology ;
  dct:title "Cascade Bridge Test Vocabulary"@en ;
  dct:description "Terms for an adapter's test manifest: three test types that carry the comparison rule, and the properties that name a test's input, expected output and the stamp predicates ignored when comparing. Used with W3C's mf: test-manifest vocabulary (mf:Manifest, mf:entries, mf:name, mf:action, mf:result)."@en ;
  dct:created "2026-09-06"^^xsd:date ;
  owl:versionInfo "v1-draft" ;
  rdfs:comment "DRAFT. The seed of the Bridge specification's test vocabulary (the-cascade-protocol/spec#43); moves to a bridge-spec repository unchanged when one exists."@en ;
  rdfs:seeAlso <https://github.com/the-cascade-protocol/spec/issues/43> .

# ----------------------------------------------------------------------------
# Test types. Each is an mf:ManifestEntry; the type is the comparison rule.
# ----------------------------------------------------------------------------

bt:IsomorphicConversionTest a owl:Class ;
  rdfs:subClassOf mf:ManifestEntry ;
  rdfs:label "Isomorphic conversion test"@en ;
  rdfs:comment "Run the mapping on bt:input; the produced graph must be isomorphic to bt:graph (blank nodes relabelled, IRIs and literals exact) after every triple whose predicate is a bt:ignorePredicate is removed from both sides; the produced findings must equal bt:findings entry for entry in the conformance sort order (sourceField, severity, reason)."@en ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge-test/v1-draft#> .

bt:InputOnlyTest a owl:Class ;
  rdfs:subClassOf mf:ManifestEntry ;
  rdfs:label "Input-only test"@en ;
  rdfs:comment "Parse and validate bt:input; record the produced graph and findings; judge nothing."@en ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge-test/v1-draft#> .

bt:DatasetCompletionTest a owl:Class ;
  rdfs:subClassOf mf:ManifestEntry ;
  rdfs:label "Dataset completion test"@en ;
  rdfs:comment "Stream bt:dataset in its envelope; the run must complete without rejection; where bt:records and bt:outputDigest are present they must match, where absent the harness records them."@en ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge-test/v1-draft#> .

# ----------------------------------------------------------------------------
# On the manifest
# ----------------------------------------------------------------------------

bt:adapter a owl:DatatypeProperty ;
  rdfs:label "adapter"@en ;
  rdfs:comment "The adapter id; must equal `id` in adapter.yaml. Exactly one on the manifest."@en ;
  rdfs:domain mf:Manifest ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge-test/v1-draft#> .

# ----------------------------------------------------------------------------
# In mf:action
# ----------------------------------------------------------------------------

bt:input a owl:ObjectProperty ;
  rdfs:label "input"@en ;
  rdfs:comment "The committed source document, by IRI. In the mf:action of a bt:IsomorphicConversionTest or bt:InputOnlyTest."@en ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge-test/v1-draft#> .

bt:dataset a owl:ObjectProperty ;
  rdfs:label "dataset"@en ;
  rdfs:comment "A Dataset entity in the crate (ro-crate-metadata.json), by its @id. In the mf:action of a bt:DatasetCompletionTest."@en ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge-test/v1-draft#> .

bt:envelope a owl:DatatypeProperty ;
  rdfs:label "envelope"@en ;
  rdfs:comment "An envelope `id` from adapter.yaml `source.envelopes`: the document root the input arrives in. In every mf:action."@en ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge-test/v1-draft#> .

# ----------------------------------------------------------------------------
# In mf:result
# ----------------------------------------------------------------------------

bt:graph a owl:ObjectProperty ;
  rdfs:label "graph"@en ;
  rdfs:comment "The expected Turtle, by IRI. In the mf:result of a bt:IsomorphicConversionTest."@en ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge-test/v1-draft#> .

bt:findings a owl:ObjectProperty ;
  rdfs:label "findings"@en ;
  rdfs:comment "The expected findings sidecar (the conformance repository's gaps.json shape), by IRI. In the mf:result of a bt:IsomorphicConversionTest."@en ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge-test/v1-draft#> .

bt:records a owl:DatatypeProperty ;
  rdfs:label "records"@en ;
  rdfs:comment "Number of units processed, a non-negative integer. In the mf:result of a bt:DatasetCompletionTest; absent until the first run records it (RDF has no null)."@en ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge-test/v1-draft#> .

bt:outputDigest a owl:DatatypeProperty ;
  rdfs:label "output digest"@en ;
  rdfs:comment "Digest of the canonical N-Quads output, stamp triples removed, as the string sha256:<64 hex>. In the mf:result of a bt:DatasetCompletionTest; absent until the first run records it (RDF has no null)."@en ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge-test/v1-draft#> .

# ----------------------------------------------------------------------------
# On the test
# ----------------------------------------------------------------------------

bt:ignorePredicate a owl:ObjectProperty ;
  rdfs:label "ignore predicate"@en ;
  rdfs:comment "A stamp predicate (a triple a Bridge adds after the mapping: RFC section 5, \"stamp\"; EIP Message History) removed from both sides before comparison. On the test, by IRI; repeatable."@en ;
  rdfs:domain mf:ManifestEntry ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge-test/v1-draft#> .
