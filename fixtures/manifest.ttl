# The cases a Bridge's harness runs for this adapter, as a W3C-style test
# manifest: W3C's mf: vocabulary plus the test terms of bridge:, declared and
# constrained by the Cascade Bridge Specification at the commit bridge:specPin
# names. Each entry has a type, an mf:action and an mf:result; the type carries
# the comparison rule, and the rule is stated in that type's rdfs:comment there,
# not here. Nothing in this repository executes it.
#
# Relative IRIs resolve against this file's location, so <in/X.xml> names the
# file the crate names as fixtures/in/X.xml, <../> is the crate's root entity
# and <> is this file. Loaded together, the manifest and the crate are one
# graph: from an entry to its input's digest, or from its envelope to the
# schema that validates it, is a walk and not a string match. Where every file
# and dataset came from is in the crate.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mf:      <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix bridge:  <https://ns.cascadeprotocol.org/bridge/v1-draft#> .
@prefix cascade: <https://ns.cascadeprotocol.org/core/v1#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .

<> a mf:Manifest ;
  rdfs:label "cascade-bridge-adapter-clinvar fixture cases" ;
  bridge:adapter <../> ; # the crate's root entity, the adapter; its bridge:testManifest is <>
  bridge:ignorePredicate cascade:dataProvenance, cascade:schemaVersion, prov:generatedAtTime ;
  mf:entries (
    <#VCV000007105-CFTR-deltaF508>
    <#VCV000017661-BRCA1>
    <#VCV000055448-BRCA2-pathogenic>
    <#VCV000208804-MLH1-LynchSyndrome>
    <#VCV_XML_VCV000091629>
    <#clinvar-vcv-release-2026-09>
  ) .

# The four conformance oracles, byte-identical to the conformance repository.
# Its file names are kept so each copy stays traceable; two do not describe the
# record inside, noted per entry.

<#VCV000007105-CFTR-deltaF508> a bridge:IsomorphicConversionTest ;
  mf:name "VCV000007105-CFTR-deltaF508" ;
  rdfs:comment "NM_000492.3(CFTR):c.1521_1523del (p.Phe508del), version 206, last updated 2026-05-03. The largest oracle: 99 submissions." ;
  mf:action [
    bridge:input <in/VCV000007105-CFTR-deltaF508.xml> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-efetch>
  ] ;
  mf:result [
    bridge:graph <expected/VCV000007105-CFTR-deltaF508.ttl> ;
    bridge:findings <findings/VCV000007105-CFTR-deltaF508.gaps.json>
  ] .

<#VCV000017661-BRCA1> a bridge:IsomorphicConversionTest ;
  mf:name "VCV000017661-BRCA1" ;
  rdfs:comment "NM_007294.4(BRCA1):c.181T>G (p.Cys61Gly), version 157, last updated 2026-05-03. About eighty IRI subjects." ;
  mf:action [
    bridge:input <in/VCV000017661-BRCA1.xml> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-efetch>
  ] ;
  mf:result [
    bridge:graph <expected/VCV000017661-BRCA1.ttl> ;
    bridge:findings <findings/VCV000017661-BRCA1.gaps.json>
  ] .

<#VCV000055448-BRCA2-pathogenic> a bridge:IsomorphicConversionTest ;
  mf:name "VCV000055448-BRCA2-pathogenic" ;
  rdfs:comment "NM_007294.4(BRCA1):c.5193+1G>C, version 15, last updated 2026-04-13. The file name says BRCA2; the record is a BRCA1 variant." ;
  mf:action [
    bridge:input <in/VCV000055448-BRCA2-pathogenic.xml> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-efetch>
  ] ;
  mf:result [
    bridge:graph <expected/VCV000055448-BRCA2-pathogenic.ttl> ;
    bridge:findings <findings/VCV000055448-BRCA2-pathogenic.gaps.json>
  ] .

<#VCV000208804-MLH1-LynchSyndrome> a bridge:IsomorphicConversionTest ;
  mf:name "VCV000208804-MLH1-LynchSyndrome" ;
  rdfs:comment "NM_001017980.4(VMA21):c.164-6T>G, version 2, last updated 2025-08-23, one submission. The file name says MLH1 and Lynch syndrome; the record is a VMA21 variant interpreted for MONDO:0010684. The smallest oracle." ;
  mf:action [
    bridge:input <in/VCV000208804-MLH1-LynchSyndrome.xml> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-efetch>
  ] ;
  mf:result [
    bridge:graph <expected/VCV000208804-MLH1-LynchSyndrome.ttl> ;
    bridge:findings <findings/VCV000208804-MLH1-LynchSyndrome.gaps.json>
  ] .

# NCBI's official sample: the one input whose provenance is unimpeachable.

<#VCV_XML_VCV000091629> a bridge:InputOnlyTest ;
  mf:name "VCV_XML_VCV000091629" ;
  rdfs:comment "NM_007294.4(BRCA1):c.4357+2T>G, version 19, last updated 2026-02-15, from pub/clinvar/xml/sample_xml/. Parsed and validated; the graph a Bridge produces is recorded, not judged." ;
  mf:action [
    bridge:input <in/VCV_XML_VCV000091629.xml> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-efetch>
  ] .

# The weekly release is not listed: on 2026-09-06 its symlink resolved to the
# monthly file below, so an entry would be a second pass over the same bytes
# (docs/format.md, "Releases"). mf:result is absent until a first run records
# bridge:records and bridge:outputDigest; RDF has no null.

<#clinvar-vcv-release-2026-09> a bridge:DatasetCompletionTest ;
  mf:name "clinvar-vcv-release-2026-09" ;
  rdfs:comment "The monthly VCV release of 2026-09 (ReleaseDate 2026-08-29), about 5.8 GB gzipped, in the ClinVarVariationRelease envelope." ;
  mf:action [
    bridge:dataset <https://ftp.ncbi.nlm.nih.gov/pub/clinvar/xml/ClinVarVCVRelease_2026-09.xml.gz> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-release>
  ] .
